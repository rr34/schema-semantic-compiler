{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema-semantic-compiler:schema-semantic-projection:1",
  "title": "Schema Semantic Compiler projection product",
  "type": "object",
  "required": [
    "product",
    "productContractVersion",
    "projectionId",
    "compiledAt",
    "compiler",
    "source",
    "operation",
    "schemaProjection",
    "compilerTrace"
  ],
  "properties": {
    "product": { "const": "schema-semantic-compiler/schema-semantic-projection" },
    "productContractVersion": { "const": 1 },
    "projectionId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "compiledAt": { "type": "string", "format": "date-time" },
    "compiler": { "type": "object" },
    "source": { "type": "object" },
    "operation": { "type": "object" },
    "schemaProjection": { "type": "object" },
    "compilerTrace": { "type": "object" }
  },
  "additionalProperties": false
}
